{
  "layer": "top",
  "position": "top",
  "height": 24,
  "modules-left": ["niri/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "backlight", "pulseaudio", "battery", "power-profiles-daemon"],
  "backlight": { "format": "bri {percent}%" },
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "pulseaudio": { "format": "vol {volume}%" },
  "battery": { "format": "bat {capacity}%" },
  "tray": { "spacing": 8 },
  "mpris": {
    "format": " {artist} - <b>{title}</b>",
    "format-paused": "  <i>{artist} - {title}</i>",
    "format-stopped": " Nothing playing",
    "tooltip-format": "{player} ({status})\n{artist} - {title}\n{position}/{length}"
  }
}
